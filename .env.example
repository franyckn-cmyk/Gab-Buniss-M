# =====================================================================
# GABON BUSINESS MAP — CONFIGURATION DES VARIABLES D'ENVIRONNEMENT
# =====================================================================

# 1. URL DU PROJET SUPABASE (Frontend & Backend)
VITE_SUPABASE_URL="https://your-project-id.supabase.co"

# 2. CLÉ PUBLIQUE SUPABASE (Exposée au navigateur pour Auth & Storage)
# Nouveau format officiel Supabase (sb_publishable_...) :
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_your_key_here"
# Rétrocompatibilité format historique (eyJ...) :
VITE_SUPABASE_ANON_KEY="your-anon-public-key"

# 3. CLÉ SECRÈTE SUPABASE (STRICTEMENT SERVEUR NODE.JS — JAMAIS DANS LE FRONTEND)
# Nouveau format officiel Supabase (sb_secret_...) :
SUPABASE_SECRET_KEY="sb_secret_your_key_here"
# Rétrocompatibilité format historique (eyJ...) :
SUPABASE_SERVICE_ROLE_KEY="your-private-service-role-key"

# 4. GEMINI AI ASSISTANT (Recherche conversationnelle tolérante aux fautes)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# 5. SECRET D'INITIALISATION TEMPORAIRE DU PREMIER SUPER-ADMINISTRATEUR
# STRICTEMENT SERVEUR — NE JAMAIS EXPOSER AU FRONTEND
# Remplacer ce placeholder par un secret aléatoire fort dans l'environnement serveur.
# Ne jamais utiliser cette valeur fictive.
GBM_BOOTSTRAP_SECRET="REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS"
GBM_ENABLE_LOCAL_HTTP_BOOTSTRAP="false"

# 6. URL DE L'APPLICATION
APP_URL="MY_APP_URL"
